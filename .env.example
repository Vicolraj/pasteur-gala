# Set these in Vercel → Project → Settings → Environment Variables.
# None of these are prefixed VITE_, so none of them ship to the browser.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gala-uploads

# Production admin access code. Checked server-side only (wire this into
# whichever endpoint verifies login once the client's App.jsx login flow
# is in — do not compare it in browser JS).
ADMIN_CODE=
